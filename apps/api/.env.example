NODE_ENV=development
PORT=4000

# Runtime queries: use a pooled connection when your provider offers one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Drizzle migrations: use a direct, non-pooled connection.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth. JWT_SECRET must be at least 32 characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# Server-side secret mixed into password hashes; at least 32 characters.
# Changing it invalidates every stored password, so treat it as permanent.
PASSWORD_PEPPER=
# Access token lifetime; keep it short, clients renew it with the refresh token.
# JWT_EXPIRES_IN_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# OAuth client ID from Google Cloud Console; /auth/google is disabled without it.
# GOOGLE_CLIENT_ID=

# Monitoring. WORKER_ENABLED runs the check scheduler and pg-boss workers in
# this process; turn it off on instances that should only serve HTTP. pg-boss
# keeps its jobs in the "pgboss" schema of the same database.
# WORKER_ENABLED=true
# CHECK_CONCURRENCY=20
# CHECK_TIMEOUT_MS=30000
# Checks older than this are deleted hourly.
# CHECK_RETENTION_DAYS=30
# Allows checks against localhost and private networks. Development only: in
# production this lets users probe your internal network.
# CHECK_ALLOW_PRIVATE_NETWORKS=false

# Logging. LOG_LEVEL accepts a single level (debug), a list (log,error) or a
# threshold (>=warn). Defaults: ">=log" in production, ">=debug" otherwise.
# LOG_LEVEL=>=debug
# LOG_JSON emits one JSON object per line. Defaults to true in production.
# LOG_JSON=false
