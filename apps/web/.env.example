# Base URL the web server uses to call the Nest API server-to-server.
# The browser never talks to this directly (see apps/web/src/server/servers.ts).
API_URL=http://localhost:4000

# Google OAuth client ID (Web application) for "Continue with Google".
# Must match the API's GOOGLE_CLIENT_ID. The button is disabled without it.
# VITE_GOOGLE_CLIENT_ID=
